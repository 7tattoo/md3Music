<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+（API 31+）暗色模式系统启动画面：背景同样用壁纸平均色，
         避免白色闪烁。 -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#8B8A89</item>
        <!-- 空矢量图标隐藏大图标，圆底背景同时置透明，完全不可见 -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
</resources>
